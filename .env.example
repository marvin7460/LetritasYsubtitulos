# Letritas runs 100% in the browser and has NO backend, so no secrets are required.
# Copy this file to `.env.local` (git-ignored) only if you want to override defaults.

# Base URL of the Hugging Face–compatible host the Whisper models are downloaded from.
# Default: https://huggingface.co/ — change it only if you mirror the models yourself.
# VITE_MODEL_HOST=https://huggingface.co/

# Optional: Chromium executable used by Playwright locally when the bundled browser
# is not available (e.g. inside containers). Not needed on a normal dev machine or in CI.
# PW_CHROMIUM_EXECUTABLE=/path/to/chromium
